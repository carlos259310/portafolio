---
import { cvData } from '../data/cv.js';
---

<section id="education" class="container">
  <h2 class="section-title">Educación y <span class="text-gradient">Certificaciones</span></h2>
  
  <div class="education-container">
    <div class="education-list">
      <h3 class="subsection-title">Formación Académica</h3>
      <div class="edu-items">
        {cvData.education.map(edu => (
          <div class="edu-card">
            <div class="edu-info">
              <span class="edu-degree">{edu.degree}</span>
              <div class="edu-meta">
                <span class="edu-institution">{edu.institution}</span>
                <span class="edu-separator">•</span>
                <span class="edu-year">{edu.year}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="certifications-list">
      <h3 class="subsection-title">Diplomados</h3>
      <div class="glass cert-card">
        <ul class="cert-items">
          {cvData.certifications.map(cert => {
            const [title, institution, year] = cert.split(' | ');
            return (
              <li class="cert-item">
                <div class="cert-info">
                  <span class="cert-title">{title}</span>
                  <div class="cert-meta">
                    <span class="cert-inst">{institution}</span>
                    <span class="cert-separator">•</span>
                    <span class="cert-year">{year}</span>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .education-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
  }

  .subsection-title {
    font-size: 1.8rem;
    margin-bottom: 2rem;
    color: var(--text-main);
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .edu-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu-card {
    position: relative;
    padding: 1.25rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .edu-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    height: 60%;
    width: 3px;
    background: linear-gradient(to bottom, var(--primary), var(--secondary));
    border-radius: 0 4px 4px 0;
    opacity: 0.8;
  }
  
  .edu-card:hover {
    background: rgba(255, 255, 255, 0.07);
    transform: translateX(10px);
    border-color: var(--primary);
    box-shadow: -5px 0 20px var(--primary-glow);
  }

  .edu-degree {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--text-main);
    font-family: var(--font-heading);
    letter-spacing: -0.01em;
  }

  .edu-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .edu-separator {
    opacity: 0.4;
  }

  .cert-card {
    padding: 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cert-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  .cert-item {
    position: relative;
    padding: 1rem 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cert-item:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateX(8px);
    border-color: var(--primary);
    box-shadow: -4px 0 15px var(--primary-glow);
  }

  .cert-title {
    display: block;
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text-main);
    margin-bottom: 0.25rem;
    font-family: var(--font-heading);
  }

  .cert-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .cert-separator {
    opacity: 0.4;
  }

  @media (max-width: 992px) {
    .education-container {
      grid-template-columns: 1fr;
    }
  }
</style>
