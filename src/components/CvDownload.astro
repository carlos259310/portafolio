---
import { getLang, useTranslations } from '../i18n/utils';
import { getCvData } from '../i18n/cv';

const lang = getLang(Astro.currentLocale);
const t    = useTranslations(lang);
const cv   = getCvData(lang);

const stats = [
  { value: t('contact.stat.years'), label: t('contact.stat.yearsLbl') },
  { value: t('contact.stat.cos'),   label: t('contact.stat.cosLbl')   },
  { value: t('contact.stat.tech'),  label: t('contact.stat.techLbl')  },
  { value: t('contact.stat.sec'),   label: t('contact.stat.secLbl')   },
];
---

<section id="contacto" class="container cv-section">
  <div class="cv-card glass reveal">

    <div class="cv-info">
      <p class="cv-eyebrow">{t('contact.eyebrow')}</p>
      <h2 class="cv-title">{t('contact.title')} <span class="text-gradient">{t('contact.highlight')}</span></h2>
      <p class="cv-desc">{t('contact.desc')}</p>

      <div class="cv-actions">
        <a
          href="https://wa.me/573023055402?text=Hola%20Carlos,%20he%20visto%20tu%20portafolio%20y%20me%20gustar%C3%ADa%20contactarte."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary contact-btn"
        >
          {t('contact.whatsapp')}
        </a>
        <a href={`mailto:${cv.personalInfo.email}`} class="btn-secondary">
          {t('contact.email')}
        </a>
      </div>
    </div>

    <div class="cv-stats">
      {stats.map((stat, i) => (
        <div class={`stat-item reveal reveal-delay-${i + 1}`}>
          <span class="stat-value text-gradient">{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .cv-section {
    padding: 4rem 0 6rem;
  }

  .cv-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
    padding: 3rem;
    position: relative;
    overflow: hidden;
  }

  .cv-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(112, 0, 255, 0.05), rgba(0, 240, 255, 0.03));
    pointer-events: none;
  }

  .cv-eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .cv-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cv-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
    max-width: 500px;
  }

  .cv-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .contact-btn {
    font-size: 1rem;
    padding: 0.9rem 1.8rem;
  }

  /* ── Stats ───────────────────────────────────────── */
  .cv-stats {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    border-left: 1px solid var(--border-soft);
    padding-left: 3rem;
    min-width: 190px;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .stat-value {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 900px) {
    .cv-card {
      grid-template-columns: 1fr;
    }

    .cv-stats {
      flex-direction: row;
      flex-wrap: wrap;
      border-left: none;
      border-top: 1px solid var(--border-soft);
      padding-left: 0;
      padding-top: 2rem;
      gap: 1.5rem 3rem;
    }
  }

  @media (max-width: 640px) {
    .cv-card {
      padding: 2rem 1.5rem;
    }

    .cv-actions {
      flex-direction: column;
    }

    .cv-actions a {
      text-align: center;
      justify-content: center;
    }
  }
</style>
