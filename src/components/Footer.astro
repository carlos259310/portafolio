---
import { getLang, useTranslations } from '../i18n/utils';
import { getCvData } from '../i18n/cv';

const lang = getLang(Astro.currentLocale);
const t    = useTranslations(lang);
const cv   = getCvData(lang);
---

<footer class="site-footer">

  <!-- Top gradient accent -->
  <div class="footer-top-line"></div>

  <div class="footer-inner">

    <!-- Ambient glow behind name -->
    <div class="footer-glow" aria-hidden="true"></div>

    <!-- Name -->
    <h2 class="footer-name text-gradient">{cv.personalInfo.name}</h2>

    <!-- Role -->
    <p class="footer-role">{t('footer.role')}</p>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <span class="copyright">&copy; <span id="footerYear"></span> {cv.personalInfo.name}. {t('footer.rights')}</span>
      <span class="divider" aria-hidden="true">·</span>
      <span class="built-with">{t('footer.built')}</span>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: var(--footer-bg);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    transition: background 0.35s ease;
    overflow: hidden;
  }

  /* Gradient accent bar */
  .footer-top-line {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--secondary) 20%,
      var(--primary) 50%,
      var(--secondary) 80%,
      transparent 100%
    );
    opacity: 0.6;
  }

  /* Main container — everything centered */
  .footer-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4rem 1.5rem 2.5rem;
    gap: 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Ambient glow blob behind the name */
  .footer-glow {
    position: absolute;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    width: 60vw;
    max-width: 600px;
    height: 200px;
    background: radial-gradient(
      ellipse at center,
      rgba(112, 0, 255, 0.12) 0%,
      rgba(0, 240, 255, 0.06) 50%,
      transparent 70%
    );
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  [data-theme="light"] .footer-glow {
    background: radial-gradient(
      ellipse at center,
      rgba(124, 58, 237, 0.08) 0%,
      rgba(2, 132, 199, 0.04) 50%,
      transparent 70%
    );
  }

  /* Large gradient name — the visual anchor */
  .footer-name {
    position: relative;
    z-index: 1;
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.6rem;
  }

  /* Role — uppercase, muted, spaced */
  .footer-role {
    position: relative;
    z-index: 1;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 2.75rem;
  }

  .dot {
    color: var(--border-medium);
    font-size: 0.9rem;
    opacity: 0.55;
  }

  /* Bottom copyright bar */
  .footer-bottom {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .copyright, .built-with {
    font-size: 0.78rem;
    color: var(--text-muted);
    opacity: 0.55;
  }

  .divider {
    color: var(--border-medium);
    font-size: 0.9rem;
    opacity: 0.55;
  }

  @media (max-width: 480px) {
    .footer-inner { padding: 3rem 1.5rem 2rem; }
    .footer-bottom { flex-direction: column; gap: 0.3rem; }
    .divider { display: none; }
  }
</style>

<script>
  const yearEl = document.getElementById('footerYear');
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
