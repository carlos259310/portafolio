---
import { getLang, useTranslations } from '../i18n/utils';
import { getCvData } from '../i18n/cv';

const lang = getLang(Astro.currentLocale);
const t    = useTranslations(lang);
const cv   = getCvData(lang);

const categoryMeta: Record<string, string> = {
  Backend:       'var(--cat-backend)',
  Frontend:      'var(--cat-frontend)',
  Database:      'var(--cat-database)',
  Integration:   'var(--cat-integration)',
  Analytics:     'var(--cat-analytics)',
  Tools:         'var(--cat-tools)',
  Methodologies: 'var(--cat-methodologies)',
};

const entries = Object.entries(cv.skills);
---

<section id="skills" class="container">
  <h2 class="section-title reveal">{t('skills.title')} <span class="text-gradient">{t('skills.highlight')}</span></h2>

  <div class="skills-grid">
    {entries.map(([category, items], index) => {
      const color = categoryMeta[category] ?? 'var(--primary)';
      return (
        <div class={`skill-category glass reveal reveal-delay-${Math.min(index + 1, 6)}`}
             style={`--cat-color: ${color}`}>
          <h3 class="category-title">{category}</h3>
          <div class="skills-list">
            {items.map(skill => <span class="skill-pill">{skill}</span>)}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .skill-category {
    padding: 1.75rem;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .skill-category::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--cat-color);
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .skill-category:hover { transform: translateY(-6px); }
  .skill-category:hover::before { opacity: 1; }

  .category-title {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
    color: var(--cat-color);
    text-transform: capitalize;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-pill {
    background: var(--surface-subtle);
    border: 1px solid var(--border-medium);
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-accent);
    transition: all 0.25s ease;
    cursor: default;
  }

  .skill-pill:hover {
    background: color-mix(in srgb, var(--cat-color) 15%, transparent);
    border-color: color-mix(in srgb, var(--cat-color) 50%, transparent);
    color: var(--text-main);
    transform: translateY(-2px);
  }
</style>
