---
import { getLang, useTranslations } from '../i18n/utils';
import { getCvData } from '../i18n/cv';

const lang = getLang(Astro.currentLocale);
const t    = useTranslations(lang);
const cv   = getCvData(lang);
---

<section id="education" class="container">
  <h2 class="section-title reveal">{t('edu.title')} <span class="text-gradient">{t('edu.highlight')}</span></h2>

  <div class="education-container">
    <div class="education-list reveal reveal-delay-1">
      <h3 class="subsection-title">{t('edu.academic')}</h3>
      <div class="edu-items">
        {cv.education.map((edu, index) => (
          <div class={`edu-card reveal reveal-delay-${Math.min(index + 2, 6)}`}>
            <div class="edu-info">
              <span class="edu-degree">{edu.degree}</span>
              <div class="edu-meta">
                <span class="edu-institution">{edu.institution}</span>
                <span class="edu-separator">•</span>
                <span class="edu-year">{edu.year}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="certifications-list reveal reveal-delay-2">
      <h3 class="subsection-title">{t('edu.diplomas')}</h3>
      <div class="glass cert-card">
        <ul class="cert-items">
          {cv.certifications.map((cert, index) => {
            const [title, institution, year] = cert.split(' | ');
            return (
              <li class={`cert-item reveal reveal-delay-${Math.min(index + 1, 6)}`}>
                <div class="cert-info">
                  <span class="cert-title">{title}</span>
                  <div class="cert-meta">
                    <span class="cert-inst">{institution}</span>
                    <span class="cert-separator">•</span>
                    <span class="cert-year">{year}</span>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .education-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
  }

  .subsection-title {
    font-size: 1.6rem;
    margin-bottom: 1.75rem;
    color: var(--text-main);
  }

  .education-list {
    display: flex;
    flex-direction: column;
  }

  .edu-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edu-card {
    position: relative;
    padding: 1.25rem 1.5rem 1.25rem 2rem;
    background: var(--surface-subtle);
    border-radius: 14px;
    border: 1px solid var(--border-subtle);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .edu-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    height: 60%;
    width: 3px;
    background: linear-gradient(to bottom, var(--primary), var(--secondary));
    border-radius: 0 4px 4px 0;
    opacity: 0.7;
  }

  .edu-card:hover {
    background: rgba(0, 240, 255, 0.04);
    transform: translateX(8px);
    border-color: rgba(0, 240, 255, 0.2);
    box-shadow: -4px 0 20px rgba(0, 240, 255, 0.08);
  }

  .edu-degree {
    display: block;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--text-main);
    font-family: var(--font-heading);
    letter-spacing: -0.01em;
  }

  .edu-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .edu-separator { opacity: 0.35; }

  .cert-card {
    padding: 1.25rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cert-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
  }

  .cert-item {
    position: relative;
    padding: 0.9rem 1.25rem 0.9rem 1.75rem;
    background: var(--surface-subtle);
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cert-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    height: 60%;
    width: 2px;
    background: linear-gradient(to bottom, var(--secondary), var(--primary));
    border-radius: 0 4px 4px 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cert-item:hover::before {
    opacity: 0.8;
  }

  .cert-item:hover {
    background: rgba(112, 0, 255, 0.05);
    transform: translateX(6px);
    border-color: rgba(168, 85, 247, 0.2);
    box-shadow: -3px 0 15px rgba(112, 0, 255, 0.08);
  }

  .cert-title {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-main);
    margin-bottom: 0.2rem;
    font-family: var(--font-heading);
  }

  .cert-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .cert-year {
    color: var(--primary);
    font-weight: 600;
  }

  .cert-separator { opacity: 0.35; }

  @media (max-width: 992px) {
    .education-container {
      grid-template-columns: 1fr;
    }
  }
</style>
