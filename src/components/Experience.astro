---
import { getLang, useTranslations } from '../i18n/utils';
import { getCvData } from '../i18n/cv';

const lang = getLang(Astro.currentLocale);
const t    = useTranslations(lang);
const cv   = getCvData(lang);
---

<section id="experience" class="container">
  <h2 class="section-title reveal">{t('exp.title')} <span class="text-gradient">{t('exp.highlight')}</span></h2>

  <div class="timeline">
    {cv.experience.map((job, index) => (
      <div class={`timeline-item reveal reveal-delay-${Math.min(index + 1, 6)}`}>
        <div class="timeline-dot"></div>
        <div class="timeline-content glass">
          <div class="job-header">
            <h3 class="job-role">{job.role}</h3>
            <span class="job-period">{job.period}</span>
          </div>
          <h4 class="job-company">
            <span class="company-name">{job.company}</span>
            <span class="company-sep">—</span>
            <span class="company-loc">{job.location}</span>
          </h4>
          <ul class="job-achievements">
            {job.achievements.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding-left: 2.5rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--primary), var(--secondary), transparent);
    opacity: 0.4;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2rem;
  }

  .timeline-item:last-child { margin-bottom: 0; }

  .timeline-dot {
    position: absolute;
    left: -2.5rem;
    top: 1.75rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg-dark);
    border: 2px solid var(--primary);
    transform: translateX(-50%);
    box-shadow: 0 0 0 3px rgba(0,240,255,0.1), 0 0 12px var(--primary-glow);
    z-index: 1;
    transition: all 0.3s ease;
  }

  .timeline-item:hover .timeline-dot {
    background: var(--primary);
    box-shadow: 0 0 0 5px rgba(0,240,255,0.15), 0 0 20px var(--primary);
    transform: translateX(-50%) scale(1.15);
  }

  .timeline-content {
    padding: 1.5rem 1.75rem;
  }

  .timeline-content:hover {
    border-color: rgba(0,240,255,0.2);
    box-shadow: 0 8px 30px rgba(0,240,255,0.08);
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .job-role {
    font-size: 1.3rem;
    margin: 0;
  }

  .job-period {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.82rem;
    color: var(--primary);
    background: rgba(0,240,255,0.06);
    padding: 0.3rem 0.8rem;
    border-radius: 8px;
    border: 1px solid rgba(0,240,255,0.15);
    white-space: nowrap;
  }

  .job-company {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-family: var(--font-sans);
    margin-bottom: 1rem;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .company-name { color: var(--text-accent); font-weight: 600; }
  .company-sep  { opacity: 0.3; }

  .job-achievements {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.93rem;
  }

  .job-achievements li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--text-accent);
    line-height: 1.6;
  }

  .job-achievements li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .job-header { flex-direction: column; }
    .timeline   { padding-left: 1.5rem; }
    .timeline-dot { left: -1.5rem; }
  }
</style>
